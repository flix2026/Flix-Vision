<?xml version="1.0" encoding="utf-8" ?>
<component name="PosterItem" extends="Group">
    <interface>
        <field id="width"        type="float" value="170" />
        <field id="height"       type="float" value="255" />
        <field id="itemContent"  type="node"  alwaysNotify="true" onChange="onContentSet" />
        <field id="focusPercent" type="float" onChange="onFocusChange" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/PosterItem.brs" />
    <children>
        <Poster id="poster" width="170" height="255" loadDisplayMode="scaleToZoom" />
        <Rectangle id="titleBg" color="0x000000CC" width="170" height="36" translation="[0,219]" />
        <Label id="titleLbl" text="" color="0xFFFFFFFF" font="font:SmallSystemFont"
               width="166" height="36" horizAlign="center" vertAlign="center"
               translation="[2,219]" />
    </children>
</component>
